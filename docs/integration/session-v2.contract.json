  "endpoints": [
    {
      "method": "GET",
      "path": "/capabilities",
      "response": "capabilities"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "body": {
        "subProfileId": "$subProfileId",
        "date": "2025-05-26",
        "createKey": "create-key-0001"
      },
      "negotiationRequired": true,
      "response": "prepared"
    },
    {
      "method": "POST",
      "path": "/sessions/$attemptId/ready",
      "ifMatch": "\"1\"",
      "body": {
        "subProfileId": "$subProfileId",
        "key": "ready-key-0001",
        "nonce": "$nonce",
        "gridHash": "31223695f63357ec3afdcb50a7208710197c89a6c70f1e37a7b0cf00e75502f0",
        "rulesVersion": "cardinal-fire-v1"
      },
      "response": "started"
    },
    {
      "method": "GET",
      "path": "/sessions/$attemptId/status?subProfileId=$subProfileId",
      "response": "started"
    },
    {
      "method": "POST",
      "path": "/sessions/$attemptId/complete",
      "ifMatch": "\"2\"",
      "body": {
        "subProfileId": "$subProfileId",
        "completionKey": "complete-key-0001",
        "transcript": {
          "version": "route-transcript-v1",
          "commands": [
            {
              "seq": 1,
              "dir": "up"
            },
            {
              "seq": 2,
              "dir": "down"
            },
            {
              "seq": 3,
              "dir": "right"
            },
            {
              "seq": 4,
              "dir": "right"
            },
            {
              "seq": 5,
              "dir": "up"
            },
            {
              "seq": 6,
              "dir": "left"
            },
            {
              "seq": 7,
              "dir": "up"
            },
            {
              "seq": 8,
              "dir": "right"
            },
            {
              "seq": 9,
              "dir": "right"
            },
            {
              "seq": 10,
              "dir": "right"
            }
          ]
        }
      },
      "response": "receipt"
    },
    {
      "method": "GET",
      "path": "/sessions/$attemptId/result?subProfileId=$subProfileId",
      "response": "receipt"
    },
    {
      "method": "POST",
      "path": "/sessions/$attemptId/recover",
      "body": {
        "subProfileId": "$subProfileId"
      },
      "response": "receiptOrRecovery"
    },
    {
      "method": "POST",
      "path": "/sessions/$attemptId/abandon",
      "ifMatch": "$currentRevision",
      "body": {
        "subProfileId": "$subProfileId",
        "key": "abandon-key-0001",
        "reason": "user-choice"
      },
      "response": "abandoned"
    }
  ],
  "strictEnvelopes": true,
  "readQueryFields": [
    "subProfileId"
  ],
